#!/bin/sh

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

mkdir -p /run /tmp
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run 2>/dev/null || true
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /tmp 2>/dev/null || true

exec >>/run/rmx3630-alpine.log 2>&1
echo "rmx3630-alpine: Alpine PID 1 entered after switch_root" >/dev/kmsg 2>/dev/null || true

if [ -c /dev/pmsg0 ]; then
    {
        printf '\nRMX3630_ALPINE: SWITCH_ROOT_OK\n'
        echo "pid=$$"
        echo "uname=$(uname -a)"
        echo "--- os-release"
        cat /etc/os-release
        echo "--- musl loader"
        ls -l /lib/ld-musl-aarch64.so.1
        echo "--- apk"
        apk --version
        echo "--- shell"
        ls -l /bin/sh
        echo "--- root mount"
        cat /proc/mounts | grep ' / '
        printf 'RMX3630_ALPINE: USERSPACE_PROBE_OK\n'
    } >/dev/pmsg0 2>/dev/null || true
fi

sleep 12
if [ -c /dev/pmsg0 ]; then
    printf '\nRMX3630_ALPINE: CLEAN_REBOOT_TO_B\n' >/dev/pmsg0 2>/dev/null || true
fi
sync
/bin/busybox reboot -f
sleep 60

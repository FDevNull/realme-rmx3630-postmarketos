#!/bin/busybox sh

PATH=/bin
export PATH
/bin/busybox --install -s /bin

mkdir -p /proc /sys /dev /run /tmp /sys/kernel/debug /newroot
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t tmpfs -o mode=0755,nosuid tmpfs /dev 2>/dev/null || true
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run 2>/dev/null || true
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /tmp 2>/dev/null || true
mount -t debugfs none /sys/kernel/debug 2>/dev/null || true
# The redirects above create a regular /dev/null when devtmpfs is unavailable.
# Replace it explicitly before mdev/systemd inherit the tmpfs.
rm -f /dev/null
mknod -m 666 /dev/null c 1 3
mknod -m 600 /dev/console c 5 1 2>/dev/null || true

pmsg_major="$(awk '$2 == "pmsg" { print $1; exit }' /proc/devices 2>/dev/null)"
if [ -n "$pmsg_major" ]; then
	mknod -m 222 /dev/pmsg0 c "$pmsg_major" 0 2>/dev/null || true
	printf '\nRMX3630_FULL_STAGE1: PID1_STARTED\n' >/dev/pmsg0 2>/dev/null || true
fi

exec >>/run/rmx3630-full-stage1.log 2>&1
mdev -s 2>/dev/null || true

pmsg_line() {
	[ -c /dev/pmsg0 ] || return 0
	printf '\nRMX3630_FULL_STAGE1: %s\n' "$*" >/dev/pmsg0 2>/dev/null || true
}

save_log() {
	reason="$1"
	[ -c /dev/pmsg0 ] || return 0
	{
		printf '\nRMX3630_FULL_STAGE1: %s\n' "$reason"
		cat /run/rmx3630-full-stage1.log
		printf '\nRMX3630_FULL_STAGE1: END_LOG\n'
	} >/dev/pmsg0 2>/dev/null || true
}

# The wrapper in the real root cancels this only after USB debug is ready.
# Mount/module/wrapper failures reboot instead of hanging indefinitely; with a
# persistent slot-A misc image this intentionally results in a diagnosable
# boot loop until the root or boot selection is repaired through Preloader.
(
	sleep 240
	pmsg_line FAILSAFE_REBOOT
	save_log FAILSAFE_REBOOT
	sync
	reboot -f
	sleep 60
) &
failsafe_pid=$!
printf '%s\n' "$failsafe_pid" >/run/rmx3630-failsafe.pid

load_one() {
	module="$1"
	path="/lib/modules/$module"
	if [ ! -f "$path" ]; then
		pmsg_line "MISSING $module"
		return
	fi
	pmsg_line "LOAD $module"
	# The stock bootloader leaves this parameter on the kernel command line,
	# but a module inserted directly with insmod does not inherit it.  Without
	# the explicit value the FocalTech driver rejects the active Samsung panel.
	case "$module" in
		oplus_bsp_tp_custom.ko)
			insmod "$path" \
				dsi_display0=oplus2269C_samsung_ams643ag01_1080p_dsi_cmd_drv-focaltech,fts &
			;;
		*)
			insmod "$path" &
			;;
	esac
	pid=$!
	elapsed=0
	while kill -0 "$pid" 2>/dev/null && [ "$elapsed" -lt 5 ]; do
		sleep 1
		elapsed=$((elapsed + 1))
	done
	if kill -0 "$pid" 2>/dev/null; then
		pmsg_line "TIMEOUT $module"
		kill -9 "$pid" 2>/dev/null || true
	elif wait "$pid" 2>/dev/null; then
		pmsg_line "DONE $module"
	else
		pmsg_line "ERROR $module"
	fi
	mdev -s 2>/dev/null || true
}

while IFS= read -r module; do
	case "$module" in
		''|'#'*) continue ;;
	esac
	load_one "$module"
done </lib/modules/modules.load.probe

if [ -c /dev/dri/card0 ]; then
	pmsg_line DRM_CARD0_OK
else
	pmsg_line DRM_CARD0_MISSING
fi

retry=0
while [ ! -b /dev/sdc71 ] && [ "$retry" -lt 20 ]; do
	mdev -s 2>/dev/null || true
	sleep 1
	retry=$((retry + 1))
done

if [ ! -b /dev/sdc71 ]; then
	save_log USERDATA_BLOCK_MISSING
	sync
	reboot -f
	sleep 60
fi

if ! mount -t ext4 -o rw,noatime /dev/sdc71 /newroot; then
	save_log USERDATA_ROOT_MOUNT_FAILED
	sync
	reboot -f
	sleep 60
fi

wrapper=/sbin/rmx3630-systemd-wrapper
if [ ! -x "/newroot$wrapper" ]; then
	save_log FULL_ROOT_WRAPPER_MISSING
	umount /newroot 2>/dev/null || true
	sync
	reboot -f
	sleep 60
fi

pmsg_line FULL_ROOT_MOUNTED
mkdir -p /newroot/proc /newroot/sys /newroot/dev /newroot/run /newroot/tmp
mount --move /proc /newroot/proc
mount --move /sys /newroot/sys
mount --move /dev /newroot/dev
mount --move /run /newroot/run
mount --move /tmp /newroot/tmp
exec switch_root -c /dev/console /newroot "$wrapper"

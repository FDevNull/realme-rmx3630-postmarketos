build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm755 "$srcdir/rmx3630-pmos-probe" \
		"$pkgdir/sbin/rmx3630-pmos-probe"
}


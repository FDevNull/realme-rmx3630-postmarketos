# Reference: <https://postmarketos.org/deviceinfo>
# Please use double quotes only. You can source this file in shell scripts.

deviceinfo_format_version="0"
deviceinfo_name="Realme 10 4G"
deviceinfo_manufacturer="Realme"
deviceinfo_codename="realme-rmx3630"
deviceinfo_year="2022"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="handset"
deviceinfo_external_storage="true"
deviceinfo_screen_width="1080"
deviceinfo_screen_height="2400"

# The stock downstream kernel boots without a working display driver for now.
deviceinfo_no_framebuffer="true"

# Boot images and the rootfs are installed by the RMX3630 port scripts because
# Realme's bootloader fastboot path rejects this device's serial number.
deviceinfo_flash_method="none"
deviceinfo_generate_bootimg="false"

# Required for devices using UFS storage.
deviceinfo_rootfs_image_sector_size="4096"

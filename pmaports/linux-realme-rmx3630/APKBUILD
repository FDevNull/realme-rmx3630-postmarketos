options="!strip !check !tracedeps"

_flavor="${pkgname#linux-}"
_kernver="5.10.209-android12-9-o-05206-g23c1467af8f7"
source="
	stock-kernel.gz
	kernel.release
"

package() {
	install -Dm644 "$srcdir/stock-kernel.gz" \
		"$pkgdir/boot/vmlinuz-$_flavor"
	install -Dm644 "$srcdir/kernel.release" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"
}


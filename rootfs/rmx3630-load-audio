#!/bin/sh
set -eu

PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH

module_dir="/usr/lib/modules/$(uname -r)/extra/rmx3630-audio"
log=/run/rmx3630-audio-modules.log
exec >>"$log" 2>&1

echo "rmx3630-audio: loading modules from $module_dir"

load_module() {
	file="$1"
	name="$2"

	if grep -q "^${name} " /proc/modules; then
		echo "rmx3630-audio: already loaded $name"
		return 0
	fi
	if [ ! -f "$module_dir/$file" ]; then
		echo "rmx3630-audio: missing $module_dir/$file" >&2
		return 1
	fi

	echo "rmx3630-audio: insmod $file"
	insmod "$module_dir/$file"
}

# Do not add oplus_chg here.  The stock charging driver dereferences Android
# services which are absent in postmarketOS and has already crashed this kernel.
load_module mtk-mbox.ko mtk_mbox
load_module mtk_rpmsg_mbox.ko mtk_rpmsg_mbox
load_module mtk_tinysys_ipi.ko mtk_tinysys_ipi
load_module mtk-afe-external.ko mtk_afe_external
load_module kernel_fb.ko kernel_fb

# This is the locally patched SCP module.  Its DVFS init/wait entry points are
# disabled because the stock SCP DVFS platform probe never completes here.
load_module scp.ko scp

load_module mt6358-accdet.ko mt6358_accdet
load_module snd-speaker_manager.ko snd_speaker_manager
load_module snd-soc-mt6366.ko snd_soc_mt6366
load_module mtk-scp-ultra.ko mtk_scp_ultra
load_module snd-soc-mtk-scp-ultra.ko snd_soc_mtk_scp_ultra
load_module mtk-scp-audiocommon.ko mtk_scp_audiocommon
load_module adsp.ko adsp
load_module audio_ipi.ko audio_ipi
load_module mtk-scp-audio.ko mtk_scp_audio
load_module snd-soc-audiodsp-common.ko snd_soc_audiodsp_common

load_module rps_perf.ko rps_perf
load_module ccmni.ko ccmni
load_module ccci_util_lib.ko ccci_util_lib
load_module ccci_auxadc.ko ccci_auxadc
load_module mtk_mdpm.ko mtk_mdpm
load_module pmic_lbat_service.ko pmic_lbat_service
load_module mtk_low_battery_throttling.ko mtk_low_battery_throttling
load_module mtk_dynamic_loading_throttling.ko mtk_dynamic_loading_throttling
load_module mtk_pbm.ko mtk_pbm
load_module ccci_md_all.ko ccci_md_all

load_module snd-soc-mtk-common.ko snd_soc_mtk_common
load_module snd-soc-mt6789-afe.ko snd_soc_mt6789_afe
load_module snd-hal-feedback.ko snd_hal_feedback
load_module snd-soc-sipa.ko snd_soc_sipa
load_module snd-audio-extend.ko snd_audio_extend
load_module mtk-sp-spk-amp.ko mtk_sp_spk_amp
load_module nvmem-mt635x-efuse.ko nvmem_mt635x_efuse
load_module mtk-btcvsd.ko mtk_btcvsd
load_module mt6789-mt6366.ko mt6789_mt6366

waited=0
while [ ! -r /proc/asound/cards ] || ! grep -q mt6789 /proc/asound/cards; do
	[ "$waited" -ge 10 ] && {
		echo "rmx3630-audio: ALSA card did not register" >&2
		exit 1
	}
	sleep 1
	waited=$((waited + 1))
done

/usr/local/sbin/rmx3630-fix-device-permissions
udevadm trigger --subsystem-match=sound 2>/dev/null || true
echo "rmx3630-audio: ALSA card ready"

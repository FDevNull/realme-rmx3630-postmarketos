#!/bin/sh
set -eu

kver="$(uname -r)"
module_dir="/usr/lib/modules/$kver/extra/rmx3630-input"

load_module() {
	module_name="$1"
	module_file="$2"

	[ -d "/sys/module/$module_name" ] && return 0
	insmod "$module_dir/$module_file"
}

# mtk-pmic-keys has a hard dependency on mtk-kpd in the stock Realme build.
load_module mtk_kpd mtk-kpd.ko
load_module mtk_pmic_keys mtk-pmic-keys.ko

# The initramfs provides a minimal /dev and some boots do not get devtmpfs or
# udev nodes for modules loaded after the hand-off.  Repair the event nodes
# before Phosh/libinput starts enumerating the seat.
/usr/local/sbin/rmx3630-fix-device-permissions
